# Copier ce fichier en .env et renseigner les valeurs. Le fichier .env n'est jamais versionné.
# En production, définir ces variables dans l'interface de l'hébergeur.

# --- Obligatoire -----------------------------------------------------------
MISTRAL_API_KEY=
PINECONE_API_KEY=
# Base PostgreSQL (Neon). Obligatoire sur Vercel ; fournie automatiquement par l'intégration Neon.
# Vide : base SQLite locale (data/app.db).
DATABASE_URL=
# Chaîne aléatoire longue : sert à anonymiser les numéros de téléphone. Ne plus la changer ensuite.
USER_HASH_SALT=

# --- WhatsApp (voir docs/WHATSAPP.md) ---------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Chaîne de votre choix, à recopier dans la configuration du webhook chez Meta.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0
# WHATSAPP_DAILY_LIMIT_PER_USER=30

# --- Administration ----------------------------------------------------------
# Jeton pour GET /admin/stats (en-tête X-Admin-Token). Vide : route désactivée.
ADMIN_TOKEN=

# --- Facultatif : modèles (identifiants exacts dans la doc Mistral) ------------
# OCR_MODEL=mistral-ocr-4-1
# EMBED_MODEL=mistral-embed
# ANALYSIS_MODEL=mistral-small-2603
# GENERATION_MODEL=mistral-medium-2604

# --- Facultatif : Pinecone et reranking ----------------------------------------
# PINECONE_INDEX_NAME=rag-fisc-cm
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# RERANK_PROVIDER=mistral       # mistral | pinecone | auto | none
# PINECONE_RERANK_MONTHLY_BUDGET=450

# --- Facultatif : stockage --------------------------------------------------------
# APP_DB_PATH=data/app.db
